OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_REASONING_EFFORT=minimal

# Hackathon demo cost controls
# Set AI_OPENAI_ENABLED=false to force deterministic fallback and spend zero credits.
AI_OPENAI_ENABLED=true
AI_DAILY_REQUEST_LIMIT=20
AI_DAILY_REQUEST_LIMIT_PER_CLIENT=3
AI_MIN_SECONDS_BETWEEN_REQUESTS=30
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=700
